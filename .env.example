# -----------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit real values.
# On Vercel, connecting Supabase through Storage → Supabase (Marketplace) adds
# equivalent variables automatically (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SECRET_KEY, POSTGRES_URL…); the app accepts either name.
# Step-by-step guide (Spanish): docs/SETUP.es.md
# -----------------------------------------------------------------------------

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (or the legacy "anon" key). Safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SECRET. The "secret" key (or the legacy "service_role" key). Server only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# SECRET. Supabase → Connect → "Transaction pooler" connection string (port 6543),
# with your database password in place of [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# OPTIONAL. The first owner normally uses the invitation code printed by
# supabase/setup.sql. Alternatively set any long random text (16+ characters)
# here and create the owner at /setup, which locks itself afterwards.
SETUP_TOKEN=

# OPTIONAL. The server applies new database migrations by itself on start-up.
# Set to false to apply supabase/migrations by hand instead.
# AUTO_MIGRATE=false
