# -----------------------------------------------------------------------------
# Copy to .env.local for local development. On Vercel, add the same variables
# in Project → Settings → Environment Variables. Never commit real values.
# Step-by-step guide (Spanish): docs/SETUP.es.md
# -----------------------------------------------------------------------------

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (or the legacy "anon" key). Safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SECRET. The "secret" key (or the legacy "service_role" key). Server only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# SECRET. Supabase → Connect → "Transaction pooler" connection string (port 6543),
# with your database password in place of [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# SECRET. Any long random text (16+ characters). Needed once, on /setup, to
# create the first owner account. Setup locks itself after that.
SETUP_TOKEN=change-me-to-a-long-random-sentence
